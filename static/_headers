# Response headers, in Cloudflare Pages' _headers format (https://developers.cloudflare.com/pages/configuration/headers/),
# applied by the docs server (server/rules.go). Supported: a path with * wildcards at the start of a line, then indented
# "Name: value" lines. Every matching rule applies; a header set by two rules gets both values, joined with ", ".
# Without a Cache-Control rule a response gets "public, max-age=0, must-revalidate". Not supported (the server refuses
# to start, and CI fails): :placeholders, host names, "! Name". Redirects get none of these headers.
# The site loads only its own files: no inline scripts or styles, no third parties. A new script, style or image host
# must be added to the Content-Security-Policy here.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Stylesheets and scripts have a content hash in their names (Hugo's fingerprint), so they never change in place.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
